<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NAP.Core\NAP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\universes\nimroel\profile.json"
             Link="config\universes\nimroel\profile.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\test-data\phase2\universe-profile-v1\profile.json"
             Link="test-data\phase2\universe-profile-v1\profile.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\schemas\nap-manifest-v2.schema.json"
             Link="schemas\nap-manifest-v2.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\schemas\nap-universe-profile-v1.schema.json"
             Link="schemas\nap-universe-profile-v1.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\test-data\phase1\first-valid-package\payload\**\*"
             Link="test-data\phase1\first-valid-package\payload\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
