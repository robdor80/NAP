<Window x:Class="NAP.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls" Title="NAP — Nexus Asset Platform" Style="{StaticResource {x:Type Window}}" WindowState="Maximized" Width="1440" Height="900" MinWidth="1200" MinHeight="700">
  <Grid Margin="{StaticResource SpaceLarge}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="NAP" FontSize="32" FontWeight="Bold" />
          <TextBlock Text="NEXUS ASSET PLATFORM" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
        <Button Content="Minimizar a bandeja" Click="HideToTray" IsEnabled="{Binding CanChangeContext}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="UNIVERSO" Style="{StaticResource Muted}" />
        <Border x:Name="SingleUniverse" Background="{StaticResource DeepBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource Stroke}" CornerRadius="{StaticResource Radius}" Padding="14,12" Margin="0,6,0,0">
          <Border.Style>
            <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSingleUniverse}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
          </Border.Style>
          <TextBlock Text="{Binding UniverseLabel}" />
        </Border>
        <ComboBox x:Name="UniverseSelector" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedUniverse}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Universo seleccionado" IsEnabled="{Binding CanChangeContext}">
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasUniverseSelector}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
          </ComboBox.Style>
        </ComboBox>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource SidebarWidth}" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="{StaticResource Radius}" Padding="12,20">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="RobDev · NAP 2.0" Style="{StaticResource Muted}" Margin="16,20,0,0" />
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding Navigation}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.Navigate, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Navigation}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompact,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,0,2"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource IconSize}" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Grid.Row="1" Header="Herramientas" Margin="8,16,0,0" IsExpanded="{Binding ToolsExpanded}" VerticalContentAlignment="Stretch">
              <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl ItemsSource="{Binding Tools}" Margin="-8,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource Navigation}" Content="{Binding Name}" Command="{Binding DataContext.Navigate, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </Expander>
          </Grid>
        </DockPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition>
            <RowDefinition.Style>
              <Style TargetType="RowDefinition">
                <Setter Property="Height" Value="Auto" />
                <Style.Triggers><DataTrigger Binding="{Binding CurrentPage.Name}" Value="RoDo"><Setter Property="Height" Value="0.28*" /></DataTrigger></Style.Triggers>
              </Style>
            </RowDefinition.Style>
          </RowDefinition>
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid x:Name="PageHeader">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Margin" Value="0,0,0,20" />
              <Style.Triggers><DataTrigger Binding="{Binding CurrentPage.Name}" Value="RoDo"><Setter Property="Margin" Value="0,0,0,8" /></DataTrigger></Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="{Binding CurrentPage.Name}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Heading}">
                  <Style.Triggers><DataTrigger Binding="{Binding CurrentPage.Name}" Value="RoDo"><Setter Property="HorizontalAlignment" Value="Left" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel x:Name="PageActions" Grid.Column="1" Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers><DataTrigger Binding="{Binding CurrentPage.Name}" Value="RoDo"><Setter Property="VerticalAlignment" Value="Top" /></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Button Content="Actualizar" Command="{Binding Refresh}" ToolTip="{Binding Refresh.DisabledReason}" />
            <Button Content="Cancelar lectura" Command="{Binding CancelRead}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Secondary}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage.State}" Value="Loading">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
          <c:RodoMascot x:Name="HeaderMascot" Grid.ColumnSpan="2" MaxWidth="300" MaxHeight="300" Margin="0,4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.Name="RoDo">
            <c:RodoMascot.Style>
              <Style TargetType="c:RodoMascot">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding CurrentPage.Name}" Value="RoDo"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </c:RodoMascot.Style>
          </c:RodoMascot>
        </Grid>
        <StackPanel Grid.Row="1">
          <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage.Name}" Value="Inicio"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding CurrentPage.Name}" Value="Producción"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding CurrentPage.Name}" Value="Historial"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="{Binding CurrentPage.Status}" Margin="0,0,0,16">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentPage.State}" Value="Ready">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CurrentPage.State}" Value="Reserved">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CurrentPage.State}" Value="Stopped">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ContentControl Content="{Binding CurrentPage.Notice}" ContentTemplate="{StaticResource Notice}">
            <ContentControl.Style>
              <Style TargetType="ContentControl">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentPage.Notice}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
          </ContentControl>
        </StackPanel>
        <ContentControl Grid.Row="2" IsEnabled="{Binding CanChangeContext}" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource CardBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Automation}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" DataContext="{Binding Automation}">
          <Button Content="{Binding DataContext.PauseLabel,RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding Pause}" ToolTip="Pausar el universo seleccionado">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanPause}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
          <Button Content="{Binding DataContext.ResumeLabel,RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding Resume}" ToolTip="Reanudar el universo seleccionado">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanResume}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Automation.ExecutionScope}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="24,0" />
        <TextBlock Text="{Binding Automation.Status}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage.Name}" Value="Inicio"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </Border>
  </Grid>
</Window>
