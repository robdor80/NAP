<Window x:Class="NAP.App.GeminiSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini · NAP" Width="540" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24">
    <TextBlock Text="Configurar Gemini" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock Text="Modelo de tu cuenta Gemini"/>
    <TextBox x:Name="Model" Margin="0,4,0,12"/>
    <TextBlock Text="Clave API (vacío conserva la clave privada guardada)" TextWrapping="Wrap"/>
    <PasswordBox x:Name="ApiKey" Margin="0,4,0,12" Padding="6"/>
    <TextBlock Text="La clave queda cifrada para tu usuario de Windows. No se copia a launch.json ni se envía a GitHub." TextWrapping="Wrap" Margin="0,0,0,12"/>
    <CheckBox x:Name="Consent" Margin="0,0,0,12"><TextBlock Text="Autorizo enviar los datos del plan de cada recurso a Gemini, con un máximo de dos intentos por ZIP en la política personal. Se aplican la cuota y los precios de mi cuenta; NAP no activa facturación." TextWrapping="Wrap"/></CheckBox>
    <TextBlock x:Name="Result" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <WrapPanel HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True"/><Button x:Name="SaveButton" Content="Guardar y aplicar" Click="Save_Click" IsDefault="True"/></WrapPanel>
  </StackPanel>
</Window>
