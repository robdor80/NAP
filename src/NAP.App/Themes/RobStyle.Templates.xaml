<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls" xmlns:v="clr-namespace:NAP.App.Views" xmlns:p="clr-namespace:NAP.Presentation;assembly=NAP.Presentation">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="RobStyle.Typography.xaml" />
    <ResourceDictionary Source="RobStyle.Controls.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <c:ToneBrushConverter x:Key="ToneBrush" />
  <c:BackupKindLabelConverter x:Key="BackupKindLabel" />
  <c:VerifiedLabelConverter x:Key="VerifiedLabel" />
  <DataTemplate DataType="{x:Type p:DashboardViewModel}">
    <v:DashboardView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:PipelineViewModel}">
    <v:PipelineView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:CatalogViewModel}">
    <v:CatalogView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:ObjectivesViewModel}">
    <v:ObjectivesView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:StatisticsViewModel}">
    <v:StatisticsView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:BackupsViewModel}">
    <v:BackupsView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:HistoryViewModel}">
    <v:HistoryView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:GitViewModel}">
    <v:GitView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:SettingsViewModel}">
    <v:SettingsView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type p:RodoViewModel}">
    <v:RodoView />
  </DataTemplate>
  <DataTemplate x:Key="ObjectiveCard">
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Filter}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
        <DockPanel>
          <TextBlock Text="{Binding Coverage}" DockPanel.Dock="Right" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
          <TextBlock Text="{Binding Remaining}" Style="{StaticResource Muted}" />
        </DockPanel>
        <ProgressBar Maximum="100" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="PipelineJob"><TextBlock Text="{Binding HumanState}" Foreground="{Binding Tone,Converter={StaticResource ToneBrush}}" Margin="4,8"/></DataTemplate>
  <DataTemplate x:Key="Notice">
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="{Binding Message}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
      <Expander Header="Diagnóstico">
        <TextBlock Text="{Binding Code}" Style="{StaticResource Technical}" />
      </Expander>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="Receipt">
    <StackPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" />
        <TextBlock Text="{Binding OperationId.Value}" Style="{StaticResource Technical}" />
      </DockPanel>
      <TextBlock Text="{Binding Branch}" Style="{StaticResource Muted}" />
      <TextBlock Text="{Binding CommitSha}" Style="{StaticResource Technical}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
