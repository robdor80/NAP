<Window x:Class="NAP.App.ComparisonWindow" x:Name="ComparisonRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls"
        Title="NAP · Comparar corrección" Width="1120" Height="820" MinWidth="840" MinHeight="560" WindowStartupLocation="CenterOwner" KeyDown="HandleKey">
  <Window.Resources><c:NormalizationPngConverter x:Key="Png"/></Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}"/>
      <TextBlock Text="{Binding ProfileChange}" Style="{StaticResource Muted}"/>
      <WrapPanel Margin="0,8,0,0"><TextBlock Text="Original: "/><TextBlock Text="{Binding OriginalSize}" Margin="0,0,24,0"/><TextBlock Text="{Binding CandidateSize}"/></WrapPanel>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="Ampliación" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button Content="−" Click="ZoomOut" AutomationProperties.Name="Reducir comparación"/>
      <TextBlock Text="{Binding ZoomValue,ElementName=ComparisonRoot,StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="12,0"/>
      <Button Content="+" Click="ZoomIn" AutomationProperties.Name="Ampliar comparación"/>
      <Button Content="Encajar" Click="Fit"/>
      <CheckBox x:Name="MarkBorders" Content="Marcar bordes añadidos" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Resalta los bordes declarados sin modificar la imagen."/>
    </WrapPanel>
    <ScrollViewer x:Name="ImageScroll" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" Background="{StaticResource PanelBrush}" Padding="8">
      <Grid x:Name="ImageStage" Width="900" Height="440">
        <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomValue,ElementName=ComparisonRoot}" ScaleY="{Binding ZoomValue,ElementName=ComparisonRoot}"/></Grid.LayoutTransform>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Original" FontWeight="SemiBold" Margin="8"/>
        <TextBlock Grid.Column="1" Text="Propuesta" FontWeight="SemiBold" Margin="8"/>
        <Image Grid.Row="1" Source="{Binding OriginalImage,Converter={StaticResource Png}}" Stretch="Uniform" Margin="8" AutomationProperties.Name="Original ampliado"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="8">
          <Image Source="{Binding CandidateImage,Converter={StaticResource Png}}" Stretch="Uniform" AutomationProperties.Name="Propuesta ampliada"/>
          <c:ComparisonBorderGuides Source="{Binding CandidateImage,Converter={StaticResource Png}}" Preview="{Binding Comparison}" ShowGuides="{Binding IsChecked,ElementName=MarkBorders}" IsHitTestVisible="False"/>
        </Grid>
      </Grid>
    </ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Cerrar comparación" Click="CloseComparison"/>
      <TextBlock Text="{Binding Transformation}" VerticalAlignment="Center" Margin="0,0,20,0"/>
    </DockPanel>
  </Grid>
</Window>
