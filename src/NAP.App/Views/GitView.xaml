<UserControl x:Class="NAP.App.Views.GitView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="OutboxRow">
      <StackPanel Margin="0,6">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Id}" Style="{StaticResource Technical}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding JobId, StringFormat='Job: {0}'}" Style="{StaticResource Technical}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Intervention}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <c:RobTitledFrame Header="ESTADO Y AUTORIZACIÓN EFECTIVA">
        <StackPanel>
          <TextBlock Text="{Binding DataContext.UniverseLabel, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}" />
          <TextBlock Text="{Binding ConfigurationSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DataContext.GitRepositoryLabel, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
          <TextBlock Text="Repositorio ligado a ProductionRoot; no se admite una ruta Git independiente." Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Configuration.Branch, StringFormat='Rama autorizada: {0}'}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Configuration.Upstream, StringFormat='Upstream autorizado: {0}'}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Configuration.RemoteName, StringFormat='Remoto autorizado: {0}'}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding HumanStatus}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Recommendation}" Foreground="{Binding RecommendationTone, Converter={StaticResource ToneBrush}}" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="Actualizar política, Outbox y recibos" Style="{StaticResource Secondary}" Command="{Binding DataContext.Refresh, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Inspeccionar local y remoto" Style="{StaticResource Primary}" Command="{Binding DataContext.InspectGit, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.InspectGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
          </WrapPanel>
          <TextBlock Text="La lectura local no consulta el remoto. Inspeccionar sí lo consulta, sin conceder permisos ni crear política." Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <Expander Header="Inspección factual y vínculos actuales">
            <StackPanel>
              <TextBlock Text="{Binding Repository.Branch, StringFormat='Rama observada: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Repository.Upstream, StringFormat='Upstream observado: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Repository.RemoteName, StringFormat='Remoto observado: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Repository.Head, StringFormat='HEAD: {0}'}" Style="{StaticResource Technical}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Repository.Synchronization, StringFormat='Sincronización observada: {0}'}" />
              <TextBlock Text="{Binding Repository.IndexIsClean, StringFormat='Index limpio: {0}'}" />
              <TextBlock Text="{Binding Configuration.RepositoryBinding, StringFormat='Binding: {0}'}" Style="{StaticResource Technical}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Configuration.IdentityFingerprint, StringFormat='Identidad: {0}'}" Style="{StaticResource Technical}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Configuration.RemoteFingerprint, StringFormat='Fingerprint remoto: {0}'}" Style="{StaticResource Technical}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Configuration.ConfigFingerprint, StringFormat='Fingerprint config: {0}'}" Style="{StaticResource Technical}" TextWrapping="Wrap" />
              <ListBox ItemsSource="{Binding Repository.Changes}" MaxHeight="200" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>
        </StackPanel>
      </c:RobTitledFrame>
      <c:RobTitledFrame Header="CONFIGURAR, REVISAR Y AUTORIZAR">
        <StackPanel>
          <TextBlock Text="Elegir un modo o marcar permisos es provisional. No guarda, no autoriza y no inicia el host." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
          <StackPanel IsEnabled="{Binding DataContext.CanChangeContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <TextBlock Text="Modo Git" /><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Modo Git provisional" />
            <WrapPanel>
              <CheckBox Content="Autorizar commit (AllowCommit)" IsChecked="{Binding AllowCommit}" IsEnabled="{Binding CommitOptionAvailable}" Margin="0,8,24,8" />
              <CheckBox Content="Autorizar push (AllowPush)" IsChecked="{Binding AllowPush}" IsEnabled="{Binding PushOptionAvailable}" Margin="0,8" />
            </WrapPanel>
            <TextBlock Text="Actor local responsable (explícito; no se infiere de credenciales)" TextWrapping="Wrap" />
            <TextBox Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Actor local responsable" />
            <TextBlock Text="Prefijos exactos relativos a ProductionRoot, uno por línea. Restringen outputs propios; no acreditan ownership." TextWrapping="Wrap" />
            <TextBox Text="{Binding Prefixes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prefijos Git permitidos" />
            <TextBlock Text="Máximo Jobs por lote (1–20)" /><TextBox Text="{Binding MaximumJobs, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" AutomationProperties.Name="Máximo Jobs por lote" />
          </StackPanel>
          <Button Content="Generar propuesta y revisar vínculos" Style="{StaticResource Secondary}" Command="{Binding DataContext.ProposeGitAuthorization, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Text="{Binding DataContext.ProposeGitAuthorization.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <Expander Header="Propuesta inmutable revisada (editar invalida la propuesta)" IsExpanded="True">
            <ItemsControl ItemsSource="{Binding Review.Details}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource Technical}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </Expander>
          <Button Content="Autorizar y guardar" Style="{StaticResource Danger}" Command="{Binding DataContext.SaveGitAuthorization, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Text="{Binding DataContext.SaveGitAuthorization.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <Button Content="Revocar autorización Git" Style="{StaticResource Danger}" Command="{Binding DataContext.RevokeGitAuthorization, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Text="{Binding DataContext.RevokeGitAuthorization.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="Revocar no necesita consultar el remoto. Conserva historial y Outbox; una autorización nueva no reactiva lotes antiguos." TextWrapping="Wrap" />
          <Expander Header="Historial de revisiones autenticado">
            <ListBox ItemsSource="{Binding PolicyHistory}" MaxHeight="180" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
              <ListBox.ItemTemplate><DataTemplate><WrapPanel><TextBlock Text="{Binding Revision, StringFormat='Revisión {0} · '}" /><TextBlock Text="{Binding Mode}" /><TextBlock Text="{Binding Revoked, StringFormat=' · Revocada: {0}'}" /><TextBlock Text="{Binding AuthorizedUtc, StringFormat=' · {0:u}'}" /></WrapPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Expander>
        </StackPanel>
      </c:RobTitledFrame>
      <c:RobTitledFrame Header="GIT OUTBOX · INTENCIONES Y LOTES">
        <StackPanel>
          <TextBlock Text="{Binding OutboxCounts}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RequireNoPendingNotice}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
          <TextBlock Text="Lotes (número exacto de Jobs)" />
          <ListBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" ItemTemplate="{StaticResource OutboxRow}" Height="200" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" />
          <TextBlock Text="Intenciones por Job (distintas de los recibos nativos)" />
          <ListBox ItemsSource="{Binding Intents}" SelectedItem="{Binding SelectedIntent}" ItemTemplate="{StaticResource OutboxRow}" Height="200" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" />
          <TextBlock Text="{Binding SelectedOutbox.Reason}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedOutbox.NextStep}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedOutbox.Intervention}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <Expander Header="Detalle técnico de la selección">
            <StackPanel DataContext="{Binding SelectedOutbox}">
              <TextBlock Text="{Binding JobId, StringFormat='JobId: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ItemId, StringFormat='QueueItemId: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AttemptId, StringFormat='AttemptId: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding BatchId, StringFormat='BatchId: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding OperationId, StringFormat='OperationId: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PlanHash, StringFormat='PlanHash: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CommitSha, StringFormat='CommitSha: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AuthorizationId, StringFormat='AuthorizationId original: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Revision, StringFormat='Revisión original: {0}'}" />
              <TextBlock Text="{Binding Diagnostic, StringFormat='Diagnóstico: {0}'}" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
          <WrapPanel>
            <Button Content="Seleccionar recibo nativo" Style="{StaticResource Secondary}" Command="{Binding DataContext.ViewOutboxReceipt, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Reintentar intent bloqueado" Style="{StaticResource Danger}" Command="{Binding DataContext.RetryBlockedGit, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Reintentar publicación del lote" Style="{StaticResource Danger}" Command="{Binding DataContext.RetryPublicationGit, RelativeSource={RelativeSource AncestorType=Window}}" />
          </WrapPanel>
          <TextBlock Text="{Binding DataContext.RetryBlockedGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DataContext.RetryPublicationGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding HostAccess.Reason}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
          <TextBlock Text="Pushed acredita un hecho durable histórico; no garantiza el tip remoto actual. Job/Queue Completed son independientes del estado Git." Style="{StaticResource Muted}" TextWrapping="Wrap" />
        </StackPanel>
      </c:RobTitledFrame>
      <c:RobTitledFrame Header="OPERACIONES MANUALES · CONFIRMACIONES INDEPENDIENTES">
        <StackPanel>
          <TextBlock Text="Mensaje del commit" /><TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="Preparar y revisar commit" Style="{StaticResource Primary}" Command="{Binding DataContext.CommitGit, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Text="{Binding DataContext.CommitGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="Commit manual requiere outputs físicamente verificados de esta sesión. La lista de sesión no reconstruye Outbox." Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource EmptyState}" />
          <ListBox ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" ItemTemplate="{StaticResource Receipt}" Height="230" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" />
          <WrapPanel>
            <Button Content="Recuperar y verificar recibo" Style="{StaticResource Secondary}" Command="{Binding DataContext.RecoverGit, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Reintentar commit Prepared" Style="{StaticResource Danger}" Command="{Binding DataContext.RetryGit, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Publicar manualmente: revisar push" Style="{StaticResource Danger}" Command="{Binding DataContext.PushGit, RelativeSource={RelativeSource AncestorType=Window}}" />
          </WrapPanel>
          <TextBlock Text="{Binding DataContext.RecoverGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DataContext.RetryGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DataContext.PushGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="Recover verifica y puede actualizar el receipt nativo; Prepared no implica commit. Cada retry y cada push requieren su propia confirmación. No se ofrece force ni reparación de anclas." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </c:RobTitledFrame>
    </StackPanel>
  </ScrollViewer>
</UserControl>
