<UserControl x:Class="NAP.App.Views.GitView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <c:RobTitledFrame Header="ESTADO DEL REPOSITORIO">
          <StackPanel>
            <TextBlock Text="{Binding HumanStatus}" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding Recommendation}" Foreground="{Binding RecommendationTone, Converter={StaticResource ToneBrush}}" Margin="0,12,0,16" />
            <Button Content="Inspeccionar local y remoto" Style="{StaticResource Primary}" Command="{Binding DataContext.InspectGit, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.InspectGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Expander Header="Detalle técnico">
              <StackPanel>
                <TextBlock Text="{Binding Repository.Branch, StringFormat='Rama: {0}'}" />
                <TextBlock Text="{Binding Repository.Head, StringFormat='HEAD: {0}'}" Style="{StaticResource Technical}" />
                <TextBlock Text="{Binding Repository.RemoteName, StringFormat='Remoto: {0}'}" />
                <TextBlock Text="{Binding Repository.Synchronization}" />
                <TextBlock Text="{Binding Repository.IndexIsClean, StringFormat='Index limpio: {0}'}" />
                <ItemsControl ItemsSource="{Binding Repository.Changes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding RelativePath}" Style="{StaticResource Technical}" />
                        <TextBlock Text="{Binding OriginalRelativePath, StringFormat='Origen: {0}'}" Style="{StaticResource Technical}" />
                        <WrapPanel>
                          <TextBlock Text="{Binding ChangeKind}" Margin="0,0,12,0" />
                          <TextBlock Text="{Binding IndexStatus, StringFormat='Index: {0}'}" Margin="0,0,12,0" />
                          <TextBlock Text="{Binding WorktreeStatus, StringFormat='Working tree: {0}'}" />
                        </WrapPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>
          </StackPanel>
        </c:RobTitledFrame>
        <c:RobTitledFrame Header="COMMIT EXPLÍCITO">
          <StackPanel>
            <TextBlock Text="Mensaje del commit" />
            <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Preparar y revisar commit" Style="{StaticResource Primary}" Command="{Binding DataContext.CommitGit, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.CommitGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="Requiere outputs físicamente verificados por una publicación de esta sesión. El catálogo nunca se usa para reconstruir esa evidencia." Style="{StaticResource Muted}" />
          </StackPanel>
        </c:RobTitledFrame>
      </StackPanel>
    </ScrollViewer>
    <c:RobTitledFrame Header="OPERACIONES" Grid.Column="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyMessage}" Style="{StaticResource EmptyState}" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <WrapPanel>
            <Button Content="Ver recibo" Style="{StaticResource Secondary}" Command="{Binding DataContext.RecoverGit, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.RecoverGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Reintentar commit" Style="{StaticResource Danger}" Command="{Binding DataContext.RetryGit, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.RetryGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Revisar push" Style="{StaticResource Danger}" Command="{Binding DataContext.PushGit, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.PushGit.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
          </WrapPanel>
          <TextBlock Text="Commit y push requieren confirmaciones separadas. STOP y las comprobaciones del Core se conservan." Foreground="{StaticResource WarningBrush}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" ItemTemplate="{StaticResource Receipt}" />
      </DockPanel>
    </c:RobTitledFrame>
  </Grid>
</UserControl>
