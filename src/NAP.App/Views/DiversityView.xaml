<UserControl x:Class="NAP.App.Views.DiversityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,16">
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="¿Qué quieres consultar de tu biblioteca?" FontSize="20" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Question,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pregunta para Gemini" MinHeight="80" MaxHeight="160" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="1200" Margin="0,16,0,12"/>
      <Button Content="Consultar IA" Command="{Binding DataContext.AskDiversity,RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.AskDiversity.DisabledReason,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource EmptyState}"/>
      <TextBlock Text="{Binding Answer.Summary}" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <ItemsControl ItemsSource="{Binding Answer.Observations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Comment}" Margin="0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
    <WrapPanel Margin="0,0,0,12"><TextBlock Text="{Binding Total,StringFormat='Total del catálogo: {0}'}" Margin="0,0,24,0"/><TextBlock Text="{Binding Origin}" Style="{StaticResource Muted}"/></WrapPanel>
    <ItemsControl ItemsSource="{Binding AnswerCounts}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <ItemsControl ItemsSource="{Binding Report.Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" Margin="0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="Ver datos utilizados" Margin="0,16,0,12"><StackPanel><ItemsControl ItemsSource="{Binding Answer.Observations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding EvidenceLabel}" Margin="0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Expander Header="Inventario completo"><ListBox ItemsSource="{Binding Report.Evidence}" DisplayMemberPath="Display" MaxHeight="320" AutomationProperties.Name="Recuentos verificables"/></Expander></StackPanel></Expander>
    <Expander Header="Categorías menos representadas" Margin="0,0,0,12"><ItemsControl ItemsSource="{Binding GapLabels}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
    <Expander Header="Opciones avanzadas"><Button Content="Copiar JSON" Click="CopyAggregateJson" HorizontalAlignment="Left"/></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
