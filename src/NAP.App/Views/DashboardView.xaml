<UserControl x:Class="NAP.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{Binding DataContext.UniverseLabel, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}"/>
          <TextBlock Text="{Binding DataContext.Automation.SimpleState, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue='Necesita atención'}" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,10,0,20" AutomationProperties.LiveSetting="Polite"/>
          <WrapPanel DataContext="{Binding DataContext.Automation, RelativeSource={RelativeSource AncestorType=Window}}">
            <Button Content="Iniciar" Command="{Binding Activate}" Style="{StaticResource Primary}" Visibility="{Binding CanActivate,Converter={StaticResource Visible}}"/>
            <Button Content="Pausar" Command="{Binding Pause}" Style="{StaticResource Primary}" Visibility="{Binding CanPause,Converter={StaticResource Visible}}"/>
            <Button Content="Reanudar" Command="{Binding Resume}" Style="{StaticResource Primary}" Visibility="{Binding CanResume,Converter={StaticResource Visible}}"/>
            <Button Content="Abrir Entrada" Click="OpenInbox" Style="{StaticResource Secondary}"/>
          </WrapPanel>
          <TextBlock Text="{Binding DataContext.Automation.Status, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource WarningBrush}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Automation.SimpleState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Necesita atención"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
      <UniformGrid Columns="3" Margin="0,0,0,8">
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pendientes" Style="{StaticResource Muted}"/><TextBlock Text="{Binding DataContext.Automation.Pending, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=—}" Style="{StaticResource Metric}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="En curso" Style="{StaticResource Muted}"/><TextBlock Text="{Binding DataContext.Automation.Processing, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=—}" Style="{StaticResource Metric}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Necesitan revisión" Style="{StaticResource Muted}"/><TextBlock Text="{Binding DataContext.Automation.NeedsReview, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=—}" Style="{StaticResource Metric}"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Visibility="{Binding DataContext.Automation.HasReview, RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Visible}}">
        <StackPanel><TextBlock Text="Necesitan atención" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding DataContext.Automation.Review, RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Margin="0,0,0,12"><Button Content="{Binding Name}" Style="{StaticResource Navigation}" Command="{Binding DataContext.OpenIncident,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ItemId}"/><TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}"/></StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Button Content="Ver incidencias" Command="{Binding DataContext.OpenIncident,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Ver historial" Command="{Binding DataContext.Navigate,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Historial"/><TextBlock Text="Actividad reciente" FontSize="18" FontWeight="SemiBold"/></DockPanel>
          <ItemsControl ItemsSource="{Binding DataContext.Automation.RecentCompact,RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl.ItemTemplate><DataTemplate>
            <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="{Binding DisplayName}" Command="{Binding DataContext.OpenIncident,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ItemId}" Style="{StaticResource Navigation}"/></DockPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="La actividad aparecerá aquí cuando se reciban recursos."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Automation.Recent.Count,RelativeSource={RelativeSource AncestorType=Window}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
      </Border>
      <Expander Header="Detalles técnicos" Margin="0,8,16,16">
        <StackPanel DataContext="{Binding DataContext.Automation,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding InboxLocation}" Style="{StaticResource Technical}"/><TextBlock Text="{Binding AuditStatus}"/><TextBlock Text="{Binding MixedInboxStatus}"/>
          <WrapPanel><Button Content="Buscar ZIP ahora" Command="{Binding ProcessPending}"/><Button Content="Detener universo" Command="{Binding StopUniverse}"/></WrapPanel>
          <Expander Header="Recibos de Entrada"><ItemsControl ItemsSource="{Binding InboxReceipts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}"/><TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
          <Expander Header="Diagnóstico de trabajos"><ItemsControl ItemsSource="{Binding Recent}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Detail}"/><TextBlock Text="{Binding Paths}" Style="{StaticResource Technical}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
          <Expander Header="Universos conectados"><ItemsControl ItemsSource="{Binding UniverseStatuses}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Universe,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding State,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Detail,Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
