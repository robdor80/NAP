<UserControl x:Class="NAP.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <UserControl.Resources>
    <Style x:Key="HomeCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="{StaticResource Space}" /></Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding DataContext.Automation.Status, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Automatización sin configurar', TargetNullValue='Automatización sin configurar'}" Style="{StaticResource Heading}" FontSize="{StaticResource CompactTitleSize}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding DataContext.Automation.MixedInboxStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                 Style="{StaticResource Muted}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding DataContext.Automation.InboxLocation, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding DataContext.Automation.AuditStatus, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="La recepción es automática mientras el universo está en marcha. Los completados cuentan trabajos nuevos; el catálogo conserva también los retratos históricos." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
      <Button Content="Iniciar automatización"
              Command="{Binding DataContext.Automation.Activate, RelativeSource={RelativeSource AncestorType=Window}}"
              ToolTip="Activa Nimroel tras confirmar; no arranca sin tu permiso."
              HorizontalAlignment="Left" Margin="0,0,0,12">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.Automation.CanActivate, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Buscar ZIP ahora"
              Command="{Binding DataContext.Automation.ProcessPending, RelativeSource={RelativeSource AncestorType=Window}}"
              ToolTip="Revisa de nuevo la bandeja del universo activo. No evita permisos ni reescribe recursos terminados."
              HorizontalAlignment="Left" Margin="0,0,0,12" />
      <Border Margin="0,0,0,12">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.Automation, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Universos conectados" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Estado informado por el Host" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding DataContext.Automation.UniverseStatuses, RelativeSource={RelativeSource AncestorType=Window}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource CardBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Universe}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Los estados se muestran solo para los universos registrados en el Host; no representan un inventario de archivos externos."
                     Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <c:RobTitledFrame Header="RECEPCIÓN DE ZIP · ÚLTIMOS RECIBOS">
        <ItemsControl ItemsSource="{Binding DataContext.Automation.InboxReceipts, RelativeSource={RelativeSource AncestorType=Window}}">
          <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/><TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </c:RobTitledFrame>
      <c:RobTitledFrame Header="TRABAJOS RECIENTES · VALIDACIÓN, GEMINI Y RESULTADOS">
        <ItemsControl ItemsSource="{Binding DataContext.Automation.Recent, RelativeSource={RelativeSource AncestorType=Window}}">
          <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6">
            <Button Content="{Binding Name}" Style="{StaticResource Navigation}" Command="{Binding DataContext.OpenIncident,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ItemId}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/><TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding Paths}" TextWrapping="Wrap" Style="{StaticResource Technical}"/>
          </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </c:RobTitledFrame>
      <TextBlock Text="{Binding DataContext.Automation.ArchivedReview, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
      <UniformGrid Columns="4">
        <Border Style="{StaticResource HomeCard}"><StackPanel><TextBlock Text="Pendientes" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DataContext.Automation.Pending, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource Metric}" /></StackPanel></Border>
        <Border Style="{StaticResource HomeCard}"><StackPanel><TextBlock Text="Procesando" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DataContext.Automation.Processing, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource Metric}" /></StackPanel></Border>
        <Border Style="{StaticResource HomeCard}"><StackPanel><TextBlock Text="Completados" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DataContext.Automation.Completed, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource Metric}" /></StackPanel></Border>
        <Border Style="{StaticResource HomeCard}"><StackPanel><TextBlock Text="Necesitan revisión" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DataContext.Automation.NeedsReview, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=—, TargetNullValue=—}" ><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Metric}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.Automation.HasReview, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
      </UniformGrid>
      <c:RobTitledFrame Header="INCIDENCIAS" Padding="24,20,24,16">
        <c:RobTitledFrame.Style><Style TargetType="c:RobTitledFrame" BasedOn="{StaticResource {x:Type c:RobTitledFrame}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Automation.HasReview, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></c:RobTitledFrame.Style>
        <StackPanel>
          <Expander Header="{Binding DataContext.Automation.ReviewLabel, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Incidencias sin consultar', TargetNullValue='Incidencias sin consultar'}" IsExpanded="{Binding DataContext.ReviewExpanded, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Margin="0,16,0,0">
              <ItemsControl ItemsSource="{Binding DataContext.Automation.Review, RelativeSource={RelativeSource AncestorType=Window}}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="{StaticResource CardBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel><Button Content="{Binding Name}" Style="{StaticResource Navigation}" Command="{Binding DataContext.OpenIncident,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ItemId}"/><TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" /></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Date}" Style="{StaticResource Muted}" Margin="24,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Ver todas las incidencias" Command="{Binding DataContext.OpenIncident,RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Text="{Binding DataContext.Automation.ReviewRemainder, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </c:RobTitledFrame>
    </StackPanel>
  </ScrollViewer>
</UserControl>
