<UserControl x:Class="NAP.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding DataContext.Automation.Status, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Automatización sin configurar', TargetNullValue='Automatización sin configurar'}" Style="{StaticResource Heading}" Margin="0,0,0,24" AutomationProperties.LiveSetting="Polite" />
      <UniformGrid Columns="4">
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pendientes" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DataContext.Automation.Pending, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource Metric}" /></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Procesando" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DataContext.Automation.Processing, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource Metric}" /></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Completados" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DataContext.Automation.Completed, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource Metric}" /></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Necesitan revisión" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DataContext.Automation.NeedsReview, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource Metric}" Foreground="{StaticResource WarningBrush}" /></StackPanel></Border>
      </UniformGrid>
      <c:RobTitledFrame Header="INCIDENCIAS">
        <StackPanel>
          <Expander Header="{Binding DataContext.Automation.ReviewLabel, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Incidencias sin consultar', TargetNullValue='Incidencias sin consultar'}" IsExpanded="{Binding DataContext.ReviewExpanded, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Margin="0,16,0,0">
              <ItemsControl ItemsSource="{Binding DataContext.Automation.Review, RelativeSource={RelativeSource AncestorType=Window}}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="{StaticResource CardBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" /></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Date}" Style="{StaticResource Muted}" Margin="24,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding DataContext.Automation.ReviewRemainder, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </c:RobTitledFrame>
    </StackPanel>
  </ScrollViewer>
</UserControl>
