<UserControl x:Class="NAP.App.Views.BackupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,16">
    <WrapPanel><Button Content="Crear copia" Style="{StaticResource Primary}" Command="{Binding DataContext.CreateBackup,RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.CreateBackup.DisabledReason,RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="Restaurar…" Command="{Binding DataContext.RestoreBackup,RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.RestoreBackup.DisabledReason,RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding CanRestoreSelection,Converter={StaticResource Visible}}"/></WrapPanel>
    <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource EmptyState}"/>
    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" MaxHeight="340" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding Entries.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Kind,Converter={StaticResource BackupKindLabel}}" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedUtc,StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding LocallyVerified,Converter={StaticResource VerifiedLabel}}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Expander Header="Opciones avanzadas" Margin="0,20,0,0"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Tipo de copia"/><ComboBox ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}"/>
      <Expander Header="Retención"><StackPanel>            <TextBlock Text="Conservar más recientes" />
            <TextBox Text="{Binding Newest, UpdateSourceTrigger=PropertyChanged}" />
            <UniformGrid Columns="3">
              <StackPanel>
                <TextBlock Text="Diarios" />
                <TextBox Text="{Binding Daily, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,8,12" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Semanales" />
                <TextBox Text="{Binding Weekly, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,8,12" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Mensuales" />
                <TextBox Text="{Binding Monthly, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </UniformGrid>
            <Button Content="Revisar plan de retención" Style="{StaticResource Danger}" Command="{Binding DataContext.RetainBackups, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.RetainBackups.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="No se elimina nada hasta confirmar el inventario concreto del plan." Foreground="{StaticResource WarningBrush}" />
</StackPanel></Expander>
      <Expander Header="Inventario y datos de la selección"><StackPanel><TextBlock Text="{Binding Selected.BackupId.Value}" Style="{StaticResource Technical}"/><TextBlock Text="{Binding Selected.CreatedUtc,StringFormat='{}{0:u}'}"/><TextBlock Text="{Binding Selected.Size,StringFormat='{}{0:N0} bytes'}"/><TextBlock Text="{Binding Selected.UniverseId.Value}"/><Button Content="Consultar Git" Command="{Binding DataContext.Navigate,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Git"/></StackPanel></Expander>
    </StackPanel></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
