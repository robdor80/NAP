<UserControl x:Class="NAP.App.Views.BackupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>
    <c:RobTitledFrame Header="COPIAS LOCALES">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyMessage}" Style="{StaticResource EmptyState}" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <Button Content="Planificar restauración" Style="{StaticResource Danger}" Command="{Binding DataContext.RestoreBackup, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.RestoreBackup.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Text="Restaurar está disponible para copias del catálogo. El plan y su universo se muestran antes de confirmar." Style="{StaticResource Muted}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{Binding Kind, Converter={StaticResource BackupKindLabel}}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding LocallyVerified, Converter={StaticResource VerifiedLabel}}" DockPanel.Dock="Right">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /><Style.Triggers><DataTrigger Binding="{Binding LocallyVerified}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </DockPanel>
                <TextBlock Text="{Binding BackupId.Value}" Style="{StaticResource Technical}" Margin="0,8,0,4" />
                <WrapPanel>
                  <TextBlock Text="{Binding CreatedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss} UTC'}" Style="{StaticResource Muted}" Margin="0,0,16,0" />
                  <TextBlock Text="{Binding Size, StringFormat='{}{0:N0} bytes'}" Style="{StaticResource Muted}" />
                </WrapPanel>
                <TextBlock Text="{Binding UniverseId.Value}" Style="{StaticResource Muted}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </c:RobTitledFrame>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <c:RobTitledFrame Header="CREAR BACKUP">
          <StackPanel>
            <TextBlock Text="Tipo de copia" />
            <ComboBox ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}" />
            <Button Content="Crear y verificar" Style="{StaticResource Primary}" Command="{Binding DataContext.CreateBackup, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.CreateBackup.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Estado Git" Style="{StaticResource Secondary}" Command="{Binding DataContext.Navigate, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Git" />
            <TextBlock Text="Operación local explícita. Los artefactos publicados conservan metadata y hashes de Core." Style="{StaticResource Muted}" />
          </StackPanel>
        </c:RobTitledFrame>
        <c:RobTitledFrame Header="RETENCIÓN">
          <StackPanel>
            <TextBlock Text="Conservar más recientes" />
            <TextBox Text="{Binding Newest, UpdateSourceTrigger=PropertyChanged}" />
            <UniformGrid Columns="3">
              <StackPanel>
                <TextBlock Text="Diarios" />
                <TextBox Text="{Binding Daily, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,8,12" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Semanales" />
                <TextBox Text="{Binding Weekly, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,8,12" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Mensuales" />
                <TextBox Text="{Binding Monthly, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </UniformGrid>
            <Button Content="Revisar plan de retención" Style="{StaticResource Danger}" Command="{Binding DataContext.RetainBackups, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.RetainBackups.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="No se elimina nada hasta confirmar el inventario concreto del plan." Foreground="{StaticResource WarningBrush}" />
          </StackPanel>
        </c:RobTitledFrame>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
