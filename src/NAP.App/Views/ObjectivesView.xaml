<UserControl x:Class="NAP.App.Views.ObjectivesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,16">
    <Expander Header="Nuevo objetivo" Margin="0,0,0,20"><Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left"><StackPanel>          <TextBlock Text="Usa los filtros activos del catálogo para medir un conjunto concreto." Style="{StaticResource Muted}" />
          <TextBlock Text="Identificador" Margin="0,16,0,0" />
          <TextBox Text="{Binding ObjectiveId, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Nombre" />
          <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Cantidad objetivo" />
          <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="Guardar objetivo" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveObjective, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.SaveObjective.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Text="El objetivo conserva los filtros activos del Catálogo." Style="{StaticResource Muted}" />
</StackPanel></Border></Expander>
    <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource EmptyState}"/>
    <ItemsControl ItemsSource="{Binding Objectives}" ItemTemplate="{StaticResource ObjectiveCard}"/>
    <Expander Header="Campañas catalogadas" Margin="0,16,0,0"><ItemsControl ItemsSource="{Binding Campaigns}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,12"><TextBlock Text="{Binding Campaign.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Objectives.Count,StringFormat='Objetivos: {0}'}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
