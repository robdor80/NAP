<UserControl x:Class="NAP.App.Views.LicenseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <c:RobTitledFrame Header="LICENCIAS">
        <StackPanel>
          <ComboBox ItemsSource="{Binding Licenses}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" AutomationProperties.Name="Licencia" MinWidth="340" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Selected.Name}" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,12" />
          <WrapPanel><TextBlock Text="Vencimiento registrado: " /><TextBlock Text="{Binding Selected.Expiry}" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Remaining}" Margin="24,0,0,0" /></WrapPanel>
          <TextBlock Text="Fecha administrativa · no verificada por el proveedor" Style="{StaticResource Muted}" Margin="0,8,0,20" />
          <TextBlock Text="{Binding Selected.Reminder}" FontWeight="SemiBold" FontSize="18" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="El aviso de renovación no determina si NAP puede ejecutarse." Style="{StaticResource Muted}" Margin="0,8,0,12" />
          <Button Content="Marcar aviso como atendido" Command="{Binding Attend}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Notice}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </c:RobTitledFrame>
      <c:RobTitledFrame Header="REGISTRAR RENOVACIÓN">
        <StackPanel><TextBlock Text="Nueva fecha de vencimiento" /><WrapPanel Margin="0,8,0,0"><DatePicker SelectedDate="{Binding RenewalDate}" Width="180" AutomationProperties.Name="Nueva fecha de vencimiento" /><Button Content="Registrar renovación" Style="{StaticResource Primary}" Command="{Binding Renew}" /></WrapPanel></StackPanel>
      </c:RobTitledFrame>
      <c:RobTitledFrame Header="HISTORIAL">
        <ItemsControl ItemsSource="{Binding Selected.History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </c:RobTitledFrame>
    </StackPanel>
  </ScrollViewer>
</UserControl>
