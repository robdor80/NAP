<UserControl x:Class="NAP.App.Views.WorkflowView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <c:NormalizationPngConverter x:Key="Png" />
  </UserControl.Resources>
  <UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseDetail}"/></UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel>
      <TextBox Width="190" MaxLength="80" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por nombre del paquete" AutomationProperties.Name="Buscar por nombre del paquete"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Apply}"/></TextBox.InputBindings></TextBox>
      <ComboBox Width="180" Margin="8,6,8,12" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Label" AutomationProperties.Name="Estado"/>
      <ComboBox Width="235" Margin="0,6,8,12" ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch}" DisplayMemberPath="Label" Visibility="{Binding HasBatches,Converter={StaticResource Visible}}" AutomationProperties.Name="Lote"/>
      <Button Content="Filtrar" Command="{Binding Apply}" Margin="0,6,0,12"/>
    </WrapPanel>
    <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource EmptyState}"/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Assets">
        <ListBox.ItemTemplate><DataTemplate>
          <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource CardBrush}" Padding="8,12">
            <StackPanel>
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{Binding Tone,Converter={StaticResource ToneBrush}}" Margin="12,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel>
              <TextBlock Text="{Binding Result}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
              <WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding Universe}" Style="{StaticResource Muted}" Margin="0,0,16,0"/><TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/></WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Column="2">
        <TextBlock Text="{Binding DetailStatus}" Style="{StaticResource EmptyState}"/>
        <ScrollViewer x:Name="ReviewDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasDetail,Converter={StaticResource Visible}}">
          <StackPanel Margin="0,0,12,0">
            <Button Content="Cerrar detalle" Command="{Binding CloseDetail}" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource CompactTitleSize}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ItemState}" Margin="0,8,0,0"/>
            <StackPanel Visibility="{Binding NeedsReview,Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Guidance}" Margin="0,8,0,16"/>
            </StackPanel>
            <Image Source="{Binding OriginalImage,Converter={StaticResource Png}}" Stretch="Uniform" MaxHeight="180" Visibility="{Binding ShowOriginal,Converter={StaticResource Visible}}" AutomationProperties.Name="Original preservado"/>
            <TextBlock Text="Vista previa no disponible"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Expander Header="Cambiar corrección" IsExpanded="{Binding EditExpanded}" Visibility="{Binding HasOptions,Converter={StaticResource Visible}}" Margin="0,12,0,0"><StackPanel>
              <TextBlock Text="Corrección para este asset" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" DisplayMemberPath="Label" AutomationProperties.Name="Corrección compatible"/>
              <Button Content="Preparar vista previa" Command="{Binding Propose}"/>
            </StackPanel></Expander>
            <StackPanel Visibility="{Binding HasPreview,Converter={StaticResource Visible}}" Margin="0,12,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Original" FontWeight="SemiBold"/><Image Source="{Binding OriginalImage,Converter={StaticResource Png}}" Stretch="Uniform" Height="120" AutomationProperties.Name="Original preservado"/><TextBlock Text="{Binding OriginalSize}" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Propuesta" FontWeight="SemiBold"/><Image Source="{Binding CandidateImage,Converter={StaticResource Png}}" Stretch="Uniform" Height="120" AutomationProperties.Name="Vista previa de la corrección"/></StackPanel>
              </Grid>
              <TextBlock Text="{Binding CandidateSize}" Margin="0,8,0,4"/>
              <TextBlock Text="{Binding Transformation}" Style="{StaticResource Muted}"/>
              <Button Content="Aprobar corrección" Command="{Binding Approve}" Margin="0,12,8,8" Visibility="{Binding CanApprove,Converter={StaticResource Visible}}"/>
              <Button Content="Continuar este asset" Command="{Binding Continue}" Visibility="{Binding CanContinue,Converter={StaticResource Visible}}"/>
            </StackPanel>
            <Expander Header="Actividad" Margin="0,20,0,12" IsExpanded="{Binding ActivityExpanded}">
              <StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding Dates}" Style="{StaticResource Muted}" Margin="0,0,0,8"/><TextBlock Text="{Binding PackageName}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                <StackPanel Visibility="{Binding HasDecisions,Converter={StaticResource Visible}}"><TextBlock Text="Decisiones guardadas" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Decisions}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Action}"/><TextBlock Text="{Binding Result}"/><TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                <ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Action}" FontWeight="SemiBold"/><TextBlock Text="{Binding Result}"/><TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <WrapPanel Visibility="{Binding HasEventPaging,Converter={StaticResource Visible}}"><Button Content="Más recientes" Command="{Binding PreviousEvents}"/><Button Content="Anteriores" Command="{Binding NextEvents}"/></WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel DockPanel.Dock="Right"><Button Content="Anterior" Command="{Binding Previous}"/><Button Content="Siguiente" Command="{Binding Next}"/></WrapPanel><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Style="{StaticResource Muted}"/></DockPanel>
  </Grid>
</UserControl>
