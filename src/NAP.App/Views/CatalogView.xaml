<UserControl x:Class="NAP.App.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:NAP.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <controls:UiValueConverter x:Key="UiValue"/>
    <DataTemplate x:Key="FacetChoice"><TextBlock Text="{Binding Value,Converter={StaticResource UiValue}}"/></DataTemplate>
  </UserControl.Resources>
  <Grid DataContext="{Binding Explorer}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel>
      <ToggleButton x:Name="FiltersToggle" DockPanel.Dock="Right" Content="Filtros" Style="{StaticResource Disclosure}" Margin="12,0,16,12" AutomationProperties.Name="Mostrar filtros del catálogo"/>
      <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding ApplyFilters}"/>
      <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Buscar recursos" ToolTip="Buscar por nombre o identificador"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApplyFilters}"/></TextBox.InputBindings></TextBox>
    </DockPanel>
    <StackPanel Grid.Row="1">
      <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked,ElementName=FiltersToggle,Converter={StaticResource Visible}}">
        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"><StackPanel>
          <WrapPanel><StackPanel Width="185" Margin="0,0,16,0"><TextBlock Text="Tipo de recurso"/><ComboBox ItemsSource="{Binding AssetTypes}" SelectedItem="{Binding AssetType}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UiValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
            <ItemsControl ItemsSource="{Binding Facets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="170" Margin="0,0,16,0"><TextBlock Text="{Binding Label}"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource FacetChoice}" AutomationProperties.Name="{Binding Label}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </WrapPanel>
          <Expander Header="Filtros avanzados"><StackPanel Width="240" HorizontalAlignment="Left"><TextBlock Text="Identificador exacto"/><TextBox Text="{Binding AssetId,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Perfil"/><ComboBox ItemsSource="{Binding ProductionProfiles}" SelectedItem="{Binding ProductionProfile}"/></StackPanel></Expander>
          <WrapPanel><Button Content="Aplicar filtros" Command="{Binding ApplyFilters}"/><Button Content="Restablecer" Command="{Binding ResetFilters}"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </Border>
      <WrapPanel Margin="0,0,0,12"><TextBlock Text="{Binding CatalogTotal,StringFormat='Total del catálogo: {0}'}" Style="{StaticResource Muted}" Margin="0,0,24,0"/><TextBlock Text="{Binding FilteredTotal,StringFormat='Resultados filtrados: {0}'}" Style="{StaticResource Muted}"/></WrapPanel>
      <TextBlock Text="{Binding CountNotice}" Style="{StaticResource EmptyState}" Foreground="{StaticResource WarningBrush}"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid>
        <ListBox x:Name="AssetGrid" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource CatalogTileContainer}" AutomationProperties.Name="Galería de recursos">
          <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingTilePanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <controls:ThumbnailView/><TextBlock Grid.Row="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold" Margin="0,12,0,4" ToolTip="{Binding Asset.AssetKey.AssetId}"/><TextBlock Grid.Row="2" Text="{Binding Subtitle}" Style="{StaticResource Muted}"/>
          </Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding CatalogEmptyMessage}" Style="{StaticResource EmptyState}" Margin="24,16" IsHitTestVisible="False"/>
      </Grid>
      <Border Grid.Column="1" Width="390" Margin="16,0,0,0" Padding="20">
        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding SelectedAsset}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Button Content="Cerrar ficha" Click="CloseDetail" HorizontalAlignment="Right"/>
          <controls:ThumbnailView DataContext="{Binding Preview}" Height="250" Margin="0,0,0,16"/>
          <TextBlock Text="{Binding SelectedName}" Style="{StaticResource Heading}" FontSize="22"/>
          <TextBlock Text="{Binding DetailType}" Style="{StaticResource Muted}" Margin="0,6,0,12"/>
          <TextBlock Text="{Binding DetailStatusText}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DetailError.Message}" Foreground="{StaticResource WarningBrush}"/>
          <TextBlock Text="{Binding DetailMessage}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}"><Style.Triggers><DataTrigger Binding="{Binding DetailState}" Value="Ready"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <ItemsControl ItemsSource="{Binding DisplayClassification}" Margin="0,12"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3"><Run Text="{Binding Key,Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Value,Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <WrapPanel Margin="0,8"><Button Content="Abrir imagen" Tag="webp" Click="OpenResource" Style="{StaticResource Primary}" IsEnabled="{Binding CanOpenWebp}"/><Button Content="Localizar archivo" Tag="folder" Click="OpenResource" IsEnabled="{Binding CanOpenFolder}"/></WrapPanel>
          <Expander Header="Más detalles"><StackPanel>
            <TextBlock Text="{Binding Detail.AuditState,StringFormat='Auditoría: {0}'}"/>
            <Button Content="Ver original" Tag="original" Click="OpenResource" IsEnabled="{Binding CanOpenMaster}" HorizontalAlignment="Left"/>
            <WrapPanel><Button Content="Fijar referencia" Click="PinComparison"/><Button Content="Comparar" Click="OpenCatalogComparison"/></WrapPanel>
            <TextBlock x:Name="ComparisonHint" Text="Selecciona una referencia para comparar" Style="{StaticResource Muted}"/>
          </StackPanel></Expander>
          <Expander Header="Detalles técnicos"><StackPanel>
            <TextBlock Text="{Binding WebpPath}" Style="{StaticResource Technical}"/><TextBlock Text="{Binding MasterPath}" Style="{StaticResource Technical}"/>
            <TextBlock Text="{Binding Detail.ProductionProfile,StringFormat='Perfil: {0}'}"/>
            <Expander Header="Clasificación y evidencias nativas"><StackPanel>          <TextBlock Text="Clasificación" FontWeight="SemiBold" Margin="0,12,0,6" />
          <ItemsControl ItemsSource="{Binding Detail.Classification}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding Mode=OneWay, Path=Key}" />
                  <Run Text=": " />
                  <Run Text="{Binding Mode=OneWay, Path=Value}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Identidad visual" FontWeight="SemiBold" Margin="0,12,0,6" />
          <ItemsControl ItemsSource="{Binding Detail.Traits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding Mode=OneWay, Path=Key}" />
                  <Run Text=": " />
                  <Run Text="{Binding Mode=OneWay, Path=Value}" />
                  <Run Text="{Binding Mode=OneWay, Path=Type, StringFormat=' ({0})'}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
              <TextBlock Text="{Binding Detail.AssetKey}" />
              <TextBlock Text="Archivo (relativa)" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.ArchiveRelativeDirectory}" TextWrapping="Wrap"  />
              <TextBlock Text="Producción (relativa)" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.ProductionRelativeDirectory}" TextWrapping="Wrap"  />
              <TextBlock Text="Maestro · bytes / SHA-256" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.MasterSizeBytes}" />
              <TextBlock Text="{Binding Detail.MasterDigest.Hex}" TextWrapping="Wrap" FontSize="{StaticResource TechnicalSize}" />
              <TextBlock Text="Producción · bytes / SHA-256" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.ProductionSizeBytes}" />
              <TextBlock Text="{Binding Detail.ProductionDigest.Hex}" TextWrapping="Wrap" FontSize="{StaticResource TechnicalSize}" />
              <ItemsControl ItemsSource="{Binding Detail.Files}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                      <StackPanel>
                        <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"  />
                        <TextBlock>
                          <Run Text="{Binding Mode=OneWay, Path=Location}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Mode=OneWay, Path=Role}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Mode=OneWay, Path=Kind}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0:N0} bytes'}" />
                        <TextBlock Text="{Binding Digest.Hex}" TextWrapping="Wrap" FontSize="{StaticResource TechnicalSize}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding DetailError.Code}" />
</StackPanel></Expander>
            <Expander Header="Evidencias históricas"><StackPanel>            <TextBlock Text="Clasificación" FontWeight="SemiBold" Margin="0,8,0,4" />
            <TextBlock Text="{Binding LegacyDetail.Culture, StringFormat='Cultura: {0}'}" />
            <TextBlock Text="{Binding LegacyDetail.Location, StringFormat='Localidad: {0}'}" />
            <TextBlock Text="{Binding LegacyDetail.Profession, StringFormat='Profesión: {0}'}" />
            <TextBlock Text="{Binding LegacyDetail.Sex, StringFormat='Sexo: {0}'}" />
            <TextBlock Text="WebP original" FontWeight="SemiBold" Margin="0,14,0,4" />
            <TextBlock Text="{Binding LegacyDetail.RelativeDirectory}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LegacyDetail.WebpBytes, StringFormat=Bytes: {0:N0}}" />
            <TextBlock Text="SHA-256" FontWeight="SemiBold" Margin="0,10,0,4" />
            <TextBlock Text="{Binding LegacyDetail.WebpSha256}" FontSize="{StaticResource TechnicalSize}" TextWrapping="Wrap" />
            <TextBlock Text="PNG maestro histórico" FontWeight="SemiBold" Margin="0,14,0,4" />
            <TextBlock Text="Sin evidencia de PNG vinculada todavía">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding MasterEvidence}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <StackPanel>
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" />
                <Style.Triggers><DataTrigger Binding="{Binding MasterEvidence}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
              </Style></StackPanel.Style>
              <TextBlock Text="{Binding MasterEvidence.StatusLabel}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MasterEvidence.CloudStatus}" Style="{StaticResource Muted}" />
              <TextBlock Text="{Binding MasterEvidence.RelativeSourcePath}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <TextBlock Text="SHA-256 del PNG descargado" FontWeight="SemiBold" Margin="0,6,0,2" />
              <TextBlock Text="{Binding MasterEvidence.PngSha256}" TextWrapping="Wrap" FontSize="{StaticResource TechnicalSize}" />
              <TextBlock Text="{Binding MasterEvidence.HistoricalSha256, StringFormat='SHA anterior: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MasterEvidence.GitCommit, StringFormat='Commit histórico: {0}'}" TextWrapping="Wrap" />
            </StackPanel>
</StackPanel></Expander>
            <Expander Header="Documentos conservados"><ItemsControl ItemsSource="{Binding Documents}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Role}"><TextBox Text="{Binding Text,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="350" VerticalScrollBarVisibility="Auto"/></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
          </StackPanel></Expander>
          <Expander Header="Gestionar recurso" Margin="0,16,0,0"><Button Content="Eliminar recurso…" Click="DeleteResource" Style="{StaticResource Danger}" Visibility="{Binding CanRemove,Converter={StaticResource Visible}}"/></Expander>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
