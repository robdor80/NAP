<UserControl x:Class="NAP.App.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:NAP.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <DataTemplate x:Key="ResourceFiles">
      <StackPanel>
        <WrapPanel Margin="0,8,0,8">
          <Button Content="Abrir carpeta" Tag="folder" Click="OpenResource" IsEnabled="{Binding CanOpenFolder}" Margin="0,0,8,8" />
          <Button Content="Ver WebP" Tag="webp" Click="OpenResource" IsEnabled="{Binding CanOpenWebp}" Margin="0,0,8,8" />
          <Button Content="Ver original" Tag="original" Click="OpenResource" IsEnabled="{Binding CanOpenMaster}" Margin="0,0,8,8" />
          <Button Content="Eliminar recurso" Click="DeleteResource" Style="{StaticResource Danger}"
                  Visibility="{Binding CanRemove,Converter={StaticResource Visible}}" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Text="WebP de producción" FontWeight="SemiBold" />
        <TextBlock Text="{Binding WebpPath,TargetNullValue='Sin ruta registrada'}" ToolTip="{Binding WebpPath}"
                   TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,2,0,8" />
        <TextBlock Text="PNG maestro" FontWeight="SemiBold" />
        <TextBlock Text="{Binding MasterPath,TargetNullValue='Sin PNG vinculado'}" ToolTip="{Binding MasterPath}"
                   TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,2,0,8" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ResourceDocuments">
      <Expander Header="Documentos conservados" Margin="0,6,0,4">
        <ItemsControl ItemsSource="{Binding Documents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Header="{Binding Role}">
                <TextBox Text="{Binding Text,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         MaxHeight="350" VerticalScrollBarVisibility="Auto" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </DataTemplate>
    <DataTemplate x:Key="FacetChoice">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Value}" />
        <TextBlock Text="{Binding TraitType, StringFormat=' · {0}'}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding TraitType}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid DataContext="{Binding Explorer}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition />
      <ColumnDefinition Width="450" MinWidth="360" />
    </Grid.ColumnDefinitions>
    <controls:RobTitledFrame Header="FILTROS">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Identificador" />
          <TextBox Text="{Binding AssetId, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Tipo" />
          <ComboBox ItemsSource="{Binding AssetTypes}" SelectedItem="{Binding AssetType}" />
          <TextBlock Text="Perfil de producción" />
          <ComboBox ItemsSource="{Binding ProductionProfiles}" SelectedItem="{Binding ProductionProfile}" />
          <ItemsControl ItemsSource="{Binding Facets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Dimension}" />
                  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource FacetChoice}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Actualizar" Command="{Binding ApplyFilters}" Style="{StaticResource Primary}" />
          <Button Content="Restablecer" Command="{Binding ResetFilters}" />
        </StackPanel>
      </ScrollViewer>
    </controls:RobTitledFrame>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <WrapPanel Grid.Row="0" HorizontalAlignment="Left" Margin="4,0,0,12">
        <Button Content="Importar retratos históricos" Click="ImportHistoricalPortraits" Margin="0,0,8,0" />
        <Button Content="Vincular 39 PNG maestros" Click="ImportHistoricalMasters" Margin="0,0,14,0" />
        <Button Content="Fijar referencia" Click="PinComparison" ToolTip="Conserva una miniatura para comparar con otro asset del mismo universo" Margin="0,0,8,0"/>
        <Button Content="Comparar selección" Click="OpenCatalogComparison" ToolTip="Abre el laboratorio visual de dos assets; solo lectura" Margin="0,0,8,0"/>
        <TextBlock x:Name="ComparisonHint" Text="Primero fija un asset y después selecciona otro" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </WrapPanel>
      <ListBox x:Name="AssetGrid" Grid.Row="1" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource CatalogTileContainer}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:VirtualizingTilePanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:ThumbnailView />
                <TextBlock Grid.Row="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,4" ToolTip="{Binding Title}" />
                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Muted}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Text="{Binding CatalogEmptyMessage}" Style="{StaticResource EmptyState}" Margin="24,16" IsHitTestVisible="False" />
    </Grid>
    <controls:RobTitledFrame Grid.Column="2" Header="FICHA" Padding="20,28,20,20">
      <Grid>
        <StackPanel>
          <StackPanel.Style><Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Detail}" Value="{x:Null}" />
                  <Condition Binding="{Binding LegacyDetail}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style></StackPanel.Style>
          <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource Heading}" />
          <TextBlock Text="{Binding DetailMessage}" Style="{StaticResource EmptyState}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Detail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel>
          <TextBlock Text="{Binding Detail.AssetKey.AssetId}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailStatusText}" FontWeight="SemiBold" Margin="0,6,0,4" />
          <TextBlock Text="{Binding UniverseName, StringFormat='Universo: {0}'}" />
          <TextBlock Text="{Binding Detail.ProductionProfile, StringFormat='Perfil: {0}'}" />
          <TextBlock Text="{Binding Detail.AuditState, StringFormat='Gemini: {0}', TargetNullValue='Gemini: sin resultado registrado'}" />
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResourceFiles}" />
          <controls:ThumbnailView DataContext="{Binding Preview}" Height="210" Margin="0,8"
                                  Visibility="{Binding DataContext.CanOpenWebp,RelativeSource={RelativeSource AncestorType=StackPanel},Converter={StaticResource Visible}}" />
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResourceDocuments}" />
          <Expander Header="Detalles técnicos">
            <StackPanel>
          <TextBlock Text="Clasificación" FontWeight="SemiBold" Margin="0,12,0,6" />
          <ItemsControl ItemsSource="{Binding Detail.Classification}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding Mode=OneWay, Path=Key}" />
                  <Run Text=": " />
                  <Run Text="{Binding Mode=OneWay, Path=Value}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Identidad visual" FontWeight="SemiBold" Margin="0,12,0,6" />
          <ItemsControl ItemsSource="{Binding Detail.Traits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding Mode=OneWay, Path=Key}" />
                  <Run Text=": " />
                  <Run Text="{Binding Mode=OneWay, Path=Value}" />
                  <Run Text="{Binding Mode=OneWay, Path=Type, StringFormat=' ({0})'}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
              <TextBlock Text="{Binding Detail.AssetKey}" />
              <TextBlock Text="Archivo (relativa)" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.ArchiveRelativeDirectory}" TextWrapping="Wrap"  />
              <TextBlock Text="Producción (relativa)" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.ProductionRelativeDirectory}" TextWrapping="Wrap"  />
              <TextBlock Text="Maestro · bytes / SHA-256" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.MasterSizeBytes}" />
              <TextBlock Text="{Binding Detail.MasterDigest.Hex}" TextWrapping="Wrap" FontSize="{StaticResource TechnicalSize}" />
              <TextBlock Text="Producción · bytes / SHA-256" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.ProductionSizeBytes}" />
              <TextBlock Text="{Binding Detail.ProductionDigest.Hex}" TextWrapping="Wrap" FontSize="{StaticResource TechnicalSize}" />
              <ItemsControl ItemsSource="{Binding Detail.Files}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                      <StackPanel>
                        <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"  />
                        <TextBlock>
                          <Run Text="{Binding Mode=OneWay, Path=Location}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Mode=OneWay, Path=Role}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Mode=OneWay, Path=Kind}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0:N0} bytes'}" />
                        <TextBlock Text="{Binding Digest.Hex}" TextWrapping="Wrap" FontSize="{StaticResource TechnicalSize}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding DetailError.Code}" />
            </StackPanel>
          </Expander>
        </StackPanel>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Style.Triggers>
                <DataTrigger Binding="{Binding LegacyDetail}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <StackPanel>
            <TextBlock Text="{Binding LegacyDetail.AssetId}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetailStatusText}" FontWeight="SemiBold" Margin="0,6,0,4" />
            <TextBlock Text="{Binding UniverseName, StringFormat='Universo: {0}'}" />
            <TextBlock Text="Perfil: portrait_npc" />
            <TextBlock Text="Gemini: retrato histórico sin auditoría de NAP" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResourceFiles}" />
            <controls:ThumbnailView DataContext="{Binding Preview}" Height="210" Margin="0,8"
                                    Visibility="{Binding DataContext.CanOpenWebp,RelativeSource={RelativeSource AncestorType=StackPanel},Converter={StaticResource Visible}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResourceDocuments}" />
            <Expander Header="Detalles técnicos">
              <StackPanel>
            <TextBlock Text="Clasificación" FontWeight="SemiBold" Margin="0,8,0,4" />
            <TextBlock Text="{Binding LegacyDetail.Culture, StringFormat='Cultura: {0}'}" />
            <TextBlock Text="{Binding LegacyDetail.Location, StringFormat='Localidad: {0}'}" />
            <TextBlock Text="{Binding LegacyDetail.Profession, StringFormat='Profesión: {0}'}" />
            <TextBlock Text="{Binding LegacyDetail.Sex, StringFormat='Sexo: {0}'}" />
            <TextBlock Text="WebP original" FontWeight="SemiBold" Margin="0,14,0,4" />
            <TextBlock Text="{Binding LegacyDetail.RelativeDirectory}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LegacyDetail.WebpBytes, StringFormat=Bytes: {0:N0}}" />
            <TextBlock Text="SHA-256" FontWeight="SemiBold" Margin="0,10,0,4" />
            <TextBlock Text="{Binding LegacyDetail.WebpSha256}" FontSize="{StaticResource TechnicalSize}" TextWrapping="Wrap" />
            <TextBlock Text="PNG maestro histórico" FontWeight="SemiBold" Margin="0,14,0,4" />
            <TextBlock Text="Sin evidencia de PNG vinculada todavía">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding MasterEvidence}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <StackPanel>
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" />
                <Style.Triggers><DataTrigger Binding="{Binding MasterEvidence}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
              </Style></StackPanel.Style>
              <TextBlock Text="{Binding MasterEvidence.StatusLabel}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MasterEvidence.CloudStatus}" Style="{StaticResource Muted}" />
              <TextBlock Text="{Binding MasterEvidence.RelativeSourcePath}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <TextBlock Text="SHA-256 del PNG descargado" FontWeight="SemiBold" Margin="0,6,0,2" />
              <TextBlock Text="{Binding MasterEvidence.PngSha256}" TextWrapping="Wrap" FontSize="{StaticResource TechnicalSize}" />
              <TextBlock Text="{Binding MasterEvidence.HistoricalSha256, StringFormat='SHA anterior: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MasterEvidence.GitCommit, StringFormat='Commit histórico: {0}'}" TextWrapping="Wrap" />
            </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </controls:RobTitledFrame>
  </Grid>
</UserControl>
