<UserControl x:Class="NAP.App.Views.PipelineView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>
    <c:RobTitledFrame Header="INBOX">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <Button Content="Preparar paquete" Style="{StaticResource Primary}" Command="{Binding DataContext.PreparePackage, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.PreparePackage.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Text="Preparar copia el ZIP a staging, valida el paquete y congela los planes. El ZIP original se conserva." Style="{StaticResource Muted}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" DisplayMemberPath="FileName" />
      </DockPanel>
    </c:RobTitledFrame>
    <c:RobTitledFrame Header="PRODUCCIÓN" Grid.Column="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <WrapPanel>
            <Button Content="Auditar plan" Style="{StaticResource Secondary}" Command="{Binding DataContext.AuditPackage, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.AuditPackage.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Publicar asset" Style="{StaticResource Primary}" Command="{Binding DataContext.ExecutePackage, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.ExecutePackage.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
          </WrapPanel>
          <TextBlock Text="{Binding Prepared.Summary}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Audit.Summary}" Style="{StaticResource Muted}" />
          <TextBlock Text="Publicar requiere una auditoría PASS real del auditor de Fase 7. RoDo conversación se reserva para Fase 15." Style="{StaticResource Muted}" Margin="0,8,0,16" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="Cada journal conserva un checkpoint, no una cronología. Solo se resalta el estado registrado." Style="{StaticResource Muted}" Margin="0,16,0,0" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" ItemTemplate="{StaticResource PipelineJob}" />
      </DockPanel>
    </c:RobTitledFrame>
  </Grid>
</UserControl>
