<UserControl x:Class="NAP.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NAP.App.Controls">
  <UserControl.Resources><c:InverseBoolConverter x:Key="InverseBool"/></UserControl.Resources>
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="General" Command="{Binding SelectSection}" CommandParameter="General"/><Button Content="Avanzado" Command="{Binding SelectSection}" CommandParameter="Avanzado"/></WrapPanel>
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="General"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Universos" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding DataContext.UniverseLabel,RelativeSource={RelativeSource AncestorType=Window},StringFormat='Universo seleccionado: {0}'}" Margin="0,12"/><Button Content="Añadir universo…" Command="{Binding DataContext.ImportProfile,RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.ImportProfile.DisabledReason,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding ProfileIssues}" ItemTemplate="{StaticResource Notice}"/><Expander Header="Universos instalados"><ItemsControl ItemsSource="{Binding InstalledProfiles}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gemini" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding DataContext.Automation.GeminiState,RelativeSource={RelativeSource AncestorType=Window},TargetNullValue='Requiere configuración'}" Margin="0,8"/><Button Content="Cambiar configuración Gemini…" Click="ConfigureGemini_Click" HorizontalAlignment="Left"/></StackPanel></Border><c:RobTitledFrame Header="APLICACIÓN">
        <StackPanel>
          <CheckBox Content="Minimizar a la bandeja durante esta sesión" IsChecked="{Binding DataContext.MinimizeToTray, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Text="Publicar requiere un auditor real configurado y una revisión PASS." Style="{StaticResource Muted}" />
        </StackPanel>
      </c:RobTitledFrame><Expander Header="Ubicaciones" Margin="0,8,0,12"><c:RobTitledFrame Header="ALMACENAMIENTO">
          <StackPanel DataContext="{Binding Explorer}">
            <TextBlock Text="Ubicaciones del universo seleccionado." Style="{StaticResource Muted}" Margin="0,0,0,16" />
            <TextBlock Text="Área de trabajo" />
            <TextBlock Text="{Binding WorkspaceStatus.Text}" Foreground="{Binding WorkspaceStatus.Tone, Converter={StaticResource ToneBrush}}" Style="{StaticResource Muted}" />
            <DockPanel IsEnabled="{Binding SettingsManagedByHost,Converter={StaticResource InverseBool}}">
              <Button DockPanel.Dock="Right" Content="Elegir…" Command="{Binding Browse}" CommandParameter="Workspace" />
              <TextBox Text="{Binding WorkspaceRoot, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Text="Producción" />
            <TextBlock Text="{Binding ProductionStatus.Text}" Foreground="{Binding ProductionStatus.Tone, Converter={StaticResource ToneBrush}}" Style="{StaticResource Muted}" />
            <DockPanel IsEnabled="{Binding SettingsManagedByHost,Converter={StaticResource InverseBool}}">
              <Button DockPanel.Dock="Right" Content="Elegir…" Command="{Binding Browse}" CommandParameter="Production" />
              <TextBox Text="{Binding ProductionRoot, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Text="Archivo de maestros" />
            <TextBlock Text="{Binding ArchiveStatus.Text}" Foreground="{Binding ArchiveStatus.Tone, Converter={StaticResource ToneBrush}}" Style="{StaticResource Muted}" />
            <DockPanel IsEnabled="{Binding SettingsManagedByHost,Converter={StaticResource InverseBool}}">
              <Button DockPanel.Dock="Right" Content="Elegir…" Command="{Binding Browse}" CommandParameter="Archive" />
              <TextBox Text="{Binding ArchiveRoot, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <Button Content="Guardar rutas del universo" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveSettings, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.SaveSettings.DisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding SettingsReadable}" />
            <Expander Header="Archivo de configuración local">
              <TextBlock Text="{Binding SettingsLocation}" Style="{StaticResource Technical}" />
            </Expander>
            <TextBlock Text="{Binding Error.Message}" Foreground="{StaticResource ErrorBrush}" />
          </StackPanel>
        </c:RobTitledFrame></Expander><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Actualizaciones" FontSize="18" FontWeight="SemiBold"/><Button Content="Consultar actualizaciones" Click="CheckUpdates_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border></StackPanel>
      </ScrollViewer>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Avanzado"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel>
          <WrapPanel><Button Content="Diagnóstico" Command="{Binding SelectSection}" CommandParameter="Diagnóstico"/><Button Content="Histórico sintético" Command="{Binding SelectSection}" CommandParameter="Histórico sintético"/><Button Content="Licencias" Command="{Binding SelectSection}" CommandParameter="Licencias"/></WrapPanel>
          <Expander Header="Configuración del HOST"><c:RobTitledFrame Header="AUTOMATIZACIÓN">
        <StackPanel>
          <TextBlock Text="Automatización sin configurar"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Automation, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <ContentControl Content="{Binding DataContext.Automation, RelativeSource={RelativeSource AncestorType=Window}}">
          <ContentControl.ContentTemplate><DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Status}" Margin="0,0,0,16" />
              <WrapPanel><Button Content="Activar universo" Command="{Binding Activate}" ToolTip="{Binding Activate.DisabledReason}" /><Button Content="Detener automatización" Command="{Binding Stop}" ToolTip="{Binding Stop.DisabledReason}" /></WrapPanel>
            </StackPanel>
          </DataTemplate></ContentControl.ContentTemplate>
          <ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><DataTrigger Binding="{Binding DataContext.Automation, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ContentControl.Style>
        </ContentControl>
        </StackPanel>
      </c:RobTitledFrame></Expander>
          <Expander Header="Almacenamiento, bases de datos, Git y archivo"><StackPanel><c:RobTitledFrame Header="CATÁLOGO">
            <StackPanel>
              <TextBlock Text="{Binding Explorer.Context.Storage.CatalogPath}" Style="{StaticResource Technical}" />
              <TextBlock Text="{Binding Explorer.CatalogStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
              <TextBlock Text="Se crea mediante Producción. Un catálogo ausente o corrupto no se reconstruye automáticamente." Style="{StaticResource Muted}" Margin="0,12,0,0" />
            </StackPanel>
          </c:RobTitledFrame>
<c:RobTitledFrame Header="GIT">
            <StackPanel>
              <TextBlock Text="{Binding Explorer.ProductionRoot}" Style="{StaticResource Technical}" />
              <Button Content="Consultar estado y recibos" Style="{StaticResource Secondary}" Command="{Binding DataContext.Navigate, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Git" />
              <TextBlock Text="Configuración Git del repositorio y remoto: inspección explícita." Style="{StaticResource Muted}" />
            </StackPanel>
          </c:RobTitledFrame>
<c:RobTitledFrame Header="ARCHIVO">
            <StackPanel>
              <TextBlock Text="{Binding Explorer.ArchiveRoot}" Style="{StaticResource Technical}" />
              <TextBlock Text="Maestros inmutables y copias locales. Core valida límites y evidencia física." Style="{StaticResource Muted}" Margin="0,12,0,0" />
            </StackPanel>
          </c:RobTitledFrame><TextBlock Text="{Binding Explorer.SettingsLocation}" Style="{StaticResource Technical}"/><TextBlock Text="{Binding ProfilesLocation}" Style="{StaticResource Technical}"/></StackPanel></Expander>
          <Expander Header="Herramientas de mantenimiento" Margin="0,12"><WrapPanel><Button Content="Importar retratos históricos" Click="ImportHistoricalPortraits"/><Button Content="Vincular PNG maestros" Click="ImportHistoricalMasters"/></WrapPanel></Expander>
          <Expander Header="Universos · detalles"><ItemsControl ItemsSource="{Binding InstalledProfiles}"><ItemsControl.ItemTemplate><DataTemplate><WrapPanel Margin="0,4"><TextBlock Text="{Binding Name}" Margin="0,0,16,0"/><TextBlock Text="{Binding Id}" Style="{StaticResource Technical}" Margin="0,0,16,0"/><TextBlock Text="{Binding Origin}"/></WrapPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
        </StackPanel>
      </ScrollViewer>
      <local:DiagnosticView xmlns:local="clr-namespace:NAP.App.Views" DataContext="{Binding Diagnostics}">
        <local:DiagnosticView.Style><Style TargetType="local:DiagnosticView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Diagnóstico"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></local:DiagnosticView.Style>
      </local:DiagnosticView>
      <local:LicenseView xmlns:local="clr-namespace:NAP.App.Views" DataContext="{Binding Licenses}">
        <local:LicenseView.Style><Style TargetType="local:LicenseView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Licencias"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></local:LicenseView.Style>
      </local:LicenseView>
      <local:HistoricalSimulationView xmlns:local="clr-namespace:NAP.App.Views" DataContext="{Binding Historical}">
        <local:HistoricalSimulationView.Style><Style TargetType="local:HistoricalSimulationView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Histórico sintético"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></local:HistoricalSimulationView.Style>
      </local:HistoricalSimulationView>
    </Grid>
  </DockPanel>
</UserControl>
