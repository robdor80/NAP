<UserControl x:Class="NAP.App.Views.StatisticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Explorer}">
    <WrapPanel Margin="0,0,0,16"><TextBlock Text="{Binding CatalogTotal,StringFormat='Total del catálogo: {0}'}" Style="{StaticResource Muted}" Margin="0,0,24,0"/><TextBlock Text="{Binding FilteredTotal,StringFormat='Resultados filtrados: {0}'}" Style="{StaticResource Muted}"/></WrapPanel>
    <TextBlock Text="{Binding CountNotice}" Foreground="{StaticResource WarningBrush}" Style="{StaticResource EmptyState}"/>
    <UniformGrid Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recursos consultados"/><TextBlock Text="{Binding StatisticsAssets}" Style="{StaticResource Metric}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Retratos"/><TextBlock Text="{Binding PortraitCount}" Style="{StaticResource Metric}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Escenas"/><TextBlock Text="{Binding SceneCount}" Style="{StaticResource Metric}"/></StackPanel></Border></UniformGrid>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Profesiones" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding DistributionEmptyMessage}" Style="{StaticResource EmptyState}"/>
      <ItemsControl ItemsSource="{Binding ProfessionDistribution}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayValue}"/><ProgressBar Grid.Column="1" Value="{Binding Percent,Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" Margin="16,0"/><TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
    <Expander Header="Explorar distribuciones detalladas" Margin="0,12,16,16"><ItemsControl ItemsSource="{Binding Distributions}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,6"><TextBlock DockPanel.Dock="Right" Text="{Binding Count}"/><TextBlock><Run Text="{Binding Label,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DisplayValue,Mode=OneWay}"/></TextBlock></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
    <Expander Header="Progreso de objetivos" Margin="0,0,16,16"><StackPanel><TextBlock Text="{Binding CoverageEmptyMessage}" Style="{StaticResource EmptyState}"/><ItemsControl ItemsSource="{Binding Planning.Objectives}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,12"><TextBlock Text="{Binding Objective.Name}"/><TextBlock><Run Text="{Binding Coverage.ActualCount,Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Coverage.TargetCount,Mode=OneWay}"/></TextBlock><ProgressBar Maximum="1" Value="{Binding Coverage.CompletionRatio,Mode=OneWay}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
