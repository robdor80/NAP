{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nap:manifest:v1",
  "title": "NAP Manifest v1",
  "description": "Identidad administrativa, clasificación estructural y referencia al perfil de producción. No contiene apariencia visual ni datos de procesamiento.",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "asset_type",
    "production_profile",
    "classification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Versión incompatible del contrato; no es la versión del asset ni SemVer."
    },
    "asset_id": {
      "$ref": "#/$defs/assetId",
      "description": "Identidad única del asset. Formato Naming v1; la coherencia dinámica con asset_type se comprueba en C#."
    },
    "asset_type": {
      "$ref": "#/$defs/machineIdentifier",
      "description": "Categoría estructural extensible. Su soporte se resolverá posteriormente en NAP.",
      "examples": ["portrait", "scene", "heraldry", "object", "environment"]
    },
    "production_profile": {
      "$ref": "#/$defs/machineIdentifier",
      "description": "Identificador del perfil; sus parámetros pertenecen a la configuración de NAP.",
      "examples": ["portrait_npc"]
    },
    "classification": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/machineIdentifier" },
      "description": "Dimensiones estructurales y valores de máquina normalizados. Las dimensiones adicionales deberán estar registradas en la futura validación semántica.",
      "properties": {
        "culture": { "$ref": "#/$defs/machineIdentifier", "description": "Cultura.", "examples": ["norgard"] },
        "realm": { "$ref": "#/$defs/machineIdentifier", "description": "Reino; opcional para portrait/portrait_npc." },
        "region": { "$ref": "#/$defs/machineIdentifier", "description": "Región; opcional para portrait/portrait_npc." },
        "location": { "$ref": "#/$defs/machineIdentifier", "description": "Localización.", "examples": ["treskal"] },
        "role": { "$ref": "#/$defs/machineIdentifier", "description": "Rol estructural.", "examples": ["farmer"] },
        "sex": { "$ref": "#/$defs/machineIdentifier", "description": "Sexo como dimensión estructural.", "examples": ["male"] }
      },
      "additionalProperties": { "$ref": "#/$defs/machineIdentifier" }
    }
  },
  "if": {
    "required": ["asset_type", "production_profile"],
    "properties": {
      "asset_type": { "const": "portrait" },
      "production_profile": { "const": "portrait_npc" }
    }
  },
  "then": {
    "properties": {
      "classification": {
        "required": ["culture", "location", "role", "sex"]
      }
    }
  },
  "$defs": {
    "machineIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
    },
    "assetId": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+_(?!000)[0-9]{3}$(?![\\s\\S])"
    }
  }
}
