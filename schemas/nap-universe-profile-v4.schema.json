{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nap:universe-profile:v4",
  "title": "NAP Universe Profile v4",
  "type": "object",
  "required": [
    "schema_version",
    "universe_id",
    "display_name",
    "classification_dimensions",
    "asset_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 4
    },
    "universe_id": {
      "$ref": "#/$defs/machineIdentifier"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "classification_dimensions": {
      "$ref": "#/$defs/dimensions"
    },
    "asset_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assetRule"
      }
    }
  },
  "$defs": {
    "machineIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
    },
    "dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/machineIdentifier"
      }
    },
    "assetRule": {
      "type": "object",
      "required": [
        "asset_type",
        "production_profile",
        "allowed_classification",
        "required_classification",
        "package_files",
        "routing",
        "conversion"
      ],
      "additionalProperties": false,
      "properties": {
        "asset_type": {
          "$ref": "#/$defs/machineIdentifier"
        },
        "production_profile": {
          "$ref": "#/$defs/machineIdentifier"
        },
        "allowed_classification": {
          "$ref": "#/$defs/dimensions"
        },
        "required_classification": {
          "$ref": "#/$defs/dimensions"
        },
        "package_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/packageFile"
          }
        },
        "routing": {
          "$ref": "#/$defs/routing"
        },
        "conversion": {
          "$ref": "#/$defs/conversion"
        }
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "segments"
      ],
      "additionalProperties": false,
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeSegment"
          }
        }
      }
    },
    "routeSegment": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "additionalProperties": false,
          "properties": {
            "literal": {
              "$ref": "#/$defs/machineIdentifier"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "classification"
          ],
          "additionalProperties": false,
          "properties": {
            "classification": {
              "$ref": "#/$defs/machineIdentifier"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "asset_id"
          ],
          "additionalProperties": false,
          "properties": {
            "asset_id": {
              "type": "boolean",
              "const": true
            }
          }
        }
      ]
    },
    "packageFile": {
      "type": "object",
      "required": [
        "role",
        "suffix",
        "extension",
        "required",
        "content_validator"
      ],
      "additionalProperties": false,
      "not": {
        "properties": {
          "suffix": {
            "const": "_manifest"
          },
          "extension": {
            "const": ".json"
          }
        }
      },
      "properties": {
        "role": {
          "$ref": "#/$defs/machineIdentifier"
        },
        "suffix": {
          "type": "string",
          "maxLength": 65,
          "pattern": "^(?:_[a-z][a-z0-9]*(?:_[a-z0-9]+)*)?$(?![\\s\\S])"
        },
        "extension": {
          "type": "string",
          "pattern": "^\\.[a-z0-9]+(?:\\.[a-z0-9]+)*$(?![\\s\\S])"
        },
        "required": {
          "type": "boolean"
        },
        "content_validator": {
          "anyOf": [
            {
              "$ref": "#/$defs/machineIdentifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "conversion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source_role",
            "output_width",
            "output_height",
            "webp_quality"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "png_to_webp"
            },
            "source_role": {
              "$ref": "#/$defs/machineIdentifier"
            },
            "output_width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16383
            },
            "output_height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16383
            },
            "webp_quality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      ]
    }
  }
}
